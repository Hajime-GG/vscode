{
    "$schema":  "vscode://schemas/color-theme",
    "name":  "Aeris Moonlit Glass",
    "type":  "dark",
    "colors":  {
                   "focusBorder":  "#C4AEB5",
                   "foreground":  "#F3F0F2",
                   "disabledForeground":  "#777176",
                   "descriptionForeground":  "#B6AFB3",
                   "errorForeground":  "#F6A7B5",
                   "icon.foreground":  "#D7D0D3",
                   "contrastBorder":  "#343A48",
                   "contrastActiveBorder":  "#B7D9F5",
                   "selection.background":  "#3B3036",
                   "textLink.foreground":  "#E4C5CE",
                   "textLink.activeForeground":  "#FFF1F4",
                   "editor.background":  "#07080B",
                   "editor.foreground":  "#F3F0F2",
                   "editorLineNumber.foreground":  "#646B7A",
                   "editorLineNumber.activeForeground":  "#E8EBF2",
                   "editorCursor.foreground":  "#F5DDE4",
                   "editor.selectionBackground":  "#3B3036",
                   "editor.inactiveSelectionBackground":  "#293544",
                   "editor.selectionHighlightBackground":  "#B7D9F51A",
                   "editor.wordHighlightBackground":  "#B7D9F51A",
                   "editor.wordHighlightStrongBackground":  "#B7D9F52B",
                   "editor.findMatchBackground":  "#846B3D80",
                   "editor.findMatchHighlightBackground":  "#846B3D40",
                   "editor.lineHighlightBackground":  "#FFFFFF06",
                   "editorIndentGuide.background1":  "#FFFFFF10",
                   "editorIndentGuide.activeBackground1":  "#B7D9F580",
                   "editorWhitespace.foreground":  "#FFFFFF18",
                   "editorRuler.foreground":  "#FFFFFF15",
                   "editorError.foreground":  "#F6A7B5",
                   "editorWarning.foreground":  "#F7D28E",
                   "editorInfo.foreground":  "#B7D9F5",
                   "editorHint.foreground":  "#9FE4C0",
                   "editorWidget.background":  "#1B1E25",
                   "editorWidget.border":  "#343A48",
                   "editorHoverWidget.background":  "#1B1E25",
                   "editorHoverWidget.border":  "#343A48",
                   "editorSuggestWidget.background":  "#1B1E25",
                   "editorSuggestWidget.border":  "#343A48",
                   "editorSuggestWidget.selectedBackground":  "#293544",
                   "sideBar.background":  "#101014",
                   "sideBar.foreground":  "#E5DEE2",
