                   "activityBar.background":  "#0A0A0E",
                   "activityBar.foreground":  "#E8EBF2",
                   "activityBar.inactiveForeground":  "#858B99",
                   "activityBar.border":  "#292E38",
                   "activityBar.activeBorder":  "#E5C8D0",
                   "activityBar.activeBackground":  "#B7D9F50D",
                   "titleBar.activeBackground":  "#101014",
                   "titleBar.activeForeground":  "#F3F0F2",
                   "titleBar.inactiveBackground":  "#0D0D11",
                   "titleBar.inactiveForeground":  "#858B99",
                   "titleBar.border":  "#282329",
                   "menubar.selectionBackground":  "#B7D9F51A",
                   "menubar.selectionForeground":  "#E8EBF2",
                   "tab.activeBackground":  "#07080B",
                   "tab.activeForeground":  "#F7F2F4",
                   "tab.inactiveBackground":  "#101014",
                   "tab.inactiveForeground":  "#969EAE",
                   "tab.border":  "#282329",
                   "tab.activeBorderTop":  "#D8BAC3",
                   "tab.unfocusedActiveBorderTop":  "#66535A",
                   "editorGroupHeader.tabsBackground":  "#101014",
                   "editorGroupHeader.tabsBorder":  "#282329",
                   "editorGroup.border":  "#282329",
                   "editorGroup.dropBackground":  "#B7D9F51A",
                   "panel.background":  "#0C0C10",
                   "panel.border":  "#282329",
                   "panelTitle.activeForeground":  "#E8EBF2",
                   "panelTitle.inactiveForeground":  "#858B99",
                   "panelTitle.activeBorder":  "#C4AEB5",
                   "terminal.background":  "#07080B",
                   "terminal.foreground":  "#EAE4E7",
                   "terminalCursor.foreground":  "#D7ECFF",
                   "terminal.ansiBlack":  "#111318",
                   "terminal.ansiRed":  "#F6A7B5",
                   "terminal.ansiGreen":  "#9FE4C0",
                   "terminal.ansiYellow":  "#F7D28E",
                   "terminal.ansiBlue":  "#B7D9F5",
                   "terminal.ansiMagenta":  "#D6B8F5",
                   "terminal.ansiCyan":  "#91DDE5",
                   "terminal.ansiWhite":  "#E8EBF2",
                   "terminal.ansiBrightBlack":  "#646B7A",
                   "terminal.ansiBrightRed":  "#FFBAC6",
                   "terminal.ansiBrightGreen":  "#B5F2D1",
                   "terminal.ansiBrightYellow":  "#FFE1A7",
                   "terminal.ansiBrightBlue":  "#D0E8FF",
                   "terminal.ansiBrightMagenta":  "#E7D3FF",
                   "terminal.ansiBrightCyan":  "#B4F1F5",
                   "terminal.ansiBrightWhite":  "#FFFFFF",
                   "statusBar.background":  "#111014",
                   "statusBar.foreground":  "#DED6DA",
                   "statusBar.border":  "#292E38",
                   "statusBar.debuggingBackground":  "#344B65",
                   "statusBar.debuggingForeground":  "#F5F7FC",
                   "statusBar.noFolderBackground":  "#111014",
                   "statusBarItem.hoverBackground":  "#B7D9F51A",
                   "statusBarItem.remoteBackground":  "#344B65",
                   "statusBarItem.remoteForeground":  "#F5F7FC",
                   "button.background":  "#292328",
                   "button.foreground":  "#F5EFF2",
                   "button.hoverBackground":  "#3A2D33",
                   "button.secondaryBackground":  "#1B171B",
                   "button.secondaryForeground":  "#F0E9EC",
                   "button.secondaryHoverBackground":  "#30252A",
                   "input.background":  "#12111A",
                   "input.foreground":  "#EAE7F2",
                   "input.border":  "#302A3B",
                   "input.placeholderForeground":  "#858B99",
                   "inputOption.activeBorder":  "#B7D9F5",
                   "dropdown.background":  "#12111A",
                   "dropdown.foreground":  "#EAE7F2",
                   "dropdown.border":  "#302A3B",
                   "list.activeSelectionBackground":  "#33272D",
                   "list.activeSelectionForeground":  "#F5F7FC",
                   "list.inactiveSelectionBackground":  "#241D21",
                   "list.hoverBackground":  "#FFFFFF08",
                   "list.focusOutline":  "#C4AEB5",
                   "list.highlightForeground":  "#B7D9F5",
                   "quickInput.background":  "#1B1E25",
                   "quickInput.foreground":  "#E8EBF2",
                   "quickInputTitle.background":  "#292E38",
                   "notificationCenterHeader.background":  "#1B1E25",
                   "notifications.background":  "#1B1E25",
                   "notifications.foreground":  "#E8EBF2",
                   "notifications.border":  "#343A48",
                   "badge.background":  "#49343C",
                   "badge.foreground":  "#FFF1F4",
                   "progressBar.background":  "#B7D9F5",
                   "breadcrumb.foreground":  "#969EAE",
                   "breadcrumb.focusForeground":  "#E8EBF2",
                   "breadcrumb.activeSelectionForeground":  "#B7D9F5",
                   "minimap.background":  "#07080B",
                   "minimap.selectionHighlight":  "#B7D9F580",
                   "minimap.findMatchHighlight":  "#F7D28F80",
                   "scrollbarSlider.background":  "#858B9926",
                   "scrollbarSlider.hoverBackground":  "#858B9940",
                   "scrollbarSlider.activeBackground":  "#B7D9F540",
                   "diffEditor.insertedTextBackground":  "#9FE4C01A",
                   "diffEditor.removedTextBackground":  "#F6A7B51A",
                   "gitDecoration.addedResourceForeground":  "#9FE4C0",
                   "gitDecoration.modifiedResourceForeground":  "#B7D9F5",
                   "gitDecoration.deletedResourceForeground":  "#F6A7B5",
                   "gitDecoration.untrackedResourceForeground":  "#9FE4C0",
                   "gitDecoration.conflictingResourceForeground":  "#F7D28E",
                   "peekView.border":  "#B7D9F5",
                   "peekViewEditor.background":  "#15171D",
                   "peekViewResult.background":  "#1B1E25",
                   "peekViewTitle.background":  "#292E38",
                   "debugToolBar.background":  "#1B1E25",
                   "debugIcon.breakpointForeground":  "#F6A7B5",
                   "welcomePage.background":  "#07080B",
                   "welcomePage.progress.foreground":  "#B7D9F5",
                   "welcomePage.tileBackground":  "#1B1E25",
                   "welcomePage.tileHoverBackground":  "#292E38",
                   "welcomePage.tileBorder":  "#343A48",
                   "extensionButton.prominentBackground":  "#B7D9F5",
                   "extensionButton.prominentForeground":  "#111820",
                   "extensionButton.prominentHoverBackground":  "#D0E8FF"
               },
    "tokenColors":  [
                        {
                            "name":  "Comments",
                            "scope":  [
                                          "comment",
                                          "punctuation.definition.comment"
                                      ],
                            "settings":  {
                                             "foreground":  "#7E8797",
                                             "fontStyle":  "italic"
                                         }
                        },
                        {
                            "name":  "Keywords",
                            "scope":  [
                                          "keyword",
                                          "storage",
                                          "storage.type",
                                          "storage.modifier"
                                      ],
                            "settings":  {
                                             "foreground":  "#E8D2DA"
                                         }
                        },
                        {
                            "name":  "Strings",
                            "scope":  [
                                          "string",
                                          "punctuation.definition.string"
                                      ],
                            "settings":  {
                                             "foreground":  "#A7DFC5"
                                         }
                        },
                        {
                            "name":  "Numbers and constants",
                            "scope":  [
                                          "constant.numeric",
                                          "constant.language",
                                          "constant.character"
                                      ],
                            "settings":  {
                                             "foreground":  "#F7D28E"
                                         }
                        },
                        {
                            "name":  "Functions",
                            "scope":  [
                                          "entity.name.function",
                                          "support.function"
                                      ],
                            "settings":  {
                                             "foreground":  "#91DDE5"
                                         }
                        },
                        {
                            "name":  "Types and classes",
                            "scope":  [
                                          "entity.name.type",
                                          "entity.name.class",
                                          "support.type",
                                          "support.class"
                                      ],
                            "settings":  {
                                             "foreground":  "#B7D9F5"
                                         }
                        },
                        {
                            "name":  "Variables and parameters",
                            "scope":  [
                                          "variable",
                                          "variable.parameter"
                                      ],
                            "settings":  {
                                             "foreground":  "#E8EBF2"
                                         }
                        },
                        {
                            "name":  "Properties",
                            "scope":  [
                                          "variable.other.property",
                                          "meta.object-literal.key"
                                      ],
                            "settings":  {
                                             "foreground":  "#E5C6D0"
                                         }
                        },
                        {
                            "name":  "Operators and punctuation",
                            "scope":  [
                                          "keyword.operator",
                                          "punctuation"
                                      ],
                            "settings":  {
                                             "foreground":  "#A8AFBD"
                                         }
                        },
                        {
                            "name":  "Typescript interfaces and enums",
                            "scope":  [
                                          "entity.name.type.interface",
                                          "entity.name.type.enum"
                                      ],
                            "settings":  {
                                             "foreground":  "#91DDE5"
                                         }
                        }
                    ]
}
