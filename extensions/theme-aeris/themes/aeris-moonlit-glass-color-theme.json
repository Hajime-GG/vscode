    "tokenColors":  [
                        {
                            "name":  "Comments",
                            "scope":  [
                                          "comment",
                                          "punctuation.definition.comment"
                                      ],
                            "settings":  {
                                             "foreground":  "#7E8797",
                                             "fontStyle":  "italic"
                                         }
                        },
                        {
                            "name":  "Keywords",
                            "scope":  [
                                          "keyword",
                                          "storage",
                                          "storage.type",
                                          "storage.modifier"
                                      ],
                            "settings":  {
                                             "foreground":  "#DCE5F2"
                                         }
                        },
                        {
                            "name":  "Strings",
                            "scope":  [
                                          "string",
                                          "punctuation.definition.string"
                                      ],
                            "settings":  {
                                             "foreground":  "#A7DFC5"
                                         }
                        },
                        {
                            "name":  "Numbers and constants",
                            "scope":  [
                                          "constant.numeric",
                                          "constant.language",
                                          "constant.character"
                                      ],
                            "settings":  {
                                             "foreground":  "#F7D28E"
                                         }
                        },
                        {
                            "name":  "Functions",
                            "scope":  [
                                          "entity.name.function",
                                          "support.function"
                                      ],
                            "settings":  {
                                             "foreground":  "#91DDE5"
                                         }
                        },
                        {
                            "name":  "Types and classes",
                            "scope":  [
                                          "entity.name.type",
                                          "entity.name.class",
                                          "support.type",
                                          "support.class"
                                      ],
                            "settings":  {
                                             "foreground":  "#B7D9F5"
                                         }
                        },
                        {
                            "name":  "Variables and parameters",
                            "scope":  [
                                          "variable",
                                          "variable.parameter"
                                      ],
                            "settings":  {
                                             "foreground":  "#E8EBF2"
                                         }
                        },
                        {
                            "name":  "Properties",
                            "scope":  [
                                          "variable.other.property",
                                          "meta.object-literal.key"
                                      ],
                            "settings":  {
                                             "foreground":  "#C9D8EC"
                                         }
                        },
                        {
                            "name":  "Operators and punctuation",
                            "scope":  [
                                          "keyword.operator",
                                          "punctuation"
                                      ],
                            "settings":  {
                                             "foreground":  "#A8AFBD"
                                         }
                        },
                        {
                            "name":  "Typescript interfaces and enums",
                            "scope":  [
                                          "entity.name.type.interface",
                                          "entity.name.type.enum"
                                      ],
                            "settings":  {
                                             "foreground":  "#91DDE5"
                                         }
                        }
                    ]
}
